{
  "tools": {
    "echo": {
      "name": "Echo",
      "description": "Development smoke-test tool. Returns the submitted text.",
      "command": "tools/examples/echo.sh",
      "args": ["{{text}}"],
      "required": ["text"],
      "patterns": {
        "text": "^.{1,500}$"
      },
      "timeout_seconds": 5,
      "max_output_bytes": 8192
    },
    "ytmp3": {
      "name": "YouTube MP3 Downloader",
      "description": "Download YouTube audio as MP3.",
      "command": "bin/ytmp3",
      "args": ["{{url}}"],
      "required": ["url"],
      "patterns": {
        "url": "^https?://(www\\.)?(youtube\\.com|youtu\\.be|music\\.youtube\\.com)/.+$"
      },
      "timeout_seconds": 300,
      "max_output_bytes": 65536,
      "output_json": true
    }
  }
}
