# =========================================================
# INFRA & NETWORK
# =========================================================
SITE_BASE_URL=http://laravel_franken:8000
SITE_PUBLIC_URL=https://example.com
AI_SHARED_NETWORK=ai_bridge_local
TZ=Asia/Jakarta
APP_LOG_LEVEL=INFO

# =========================================================
# INTERNAL API (LARAVEL <-> FASTAPI)
# =========================================================
SEARCH_API_URL=http://laravel_franken:8000/api/internal/ai/search
SEARCH_API_KEY=change-this-long-random-key
INTERNAL_INDEX_KEY=change-this-long-random-key

TOOL_MANIFEST_API_URL=http://laravel_franken:8000/api/internal/ai/tools
TOOL_MANIFEST_TTL=300
TOOL_MANIFEST_MAX_ITEMS=200

CATALOG_API_URL=http://laravel_franken:8000/api/internal/ai/catalog
CATALOG_API_KEY=change-this-long-random-key
CATALOG_TTL=300
CATALOG_MAX_ITEMS=250

# =========================================================
# CRAWLING, INDEXING, STORAGE
# =========================================================
CRAWL_TTL=21600
CRAWL_MAX_PAGES=60
CRAWL_DISCOVERY_MAX_PAGES=120
CRAWL_PAGE_TEXT_MAX_CHARS=12000

KB_CACHE_PATH=/var/lib/ai_fastapi/kb_cache.json
VECTOR_DB_PATH=/var/lib/ai_fastapi/vector_store.db

# =========================================================
# RETRIEVAL / RAG
# =========================================================
CONTEXT_PAGE_CONTENT_CHARS=2200
CONTEXT_MAX_PAGES=8

RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=140
RAG_CHUNK_TOP_K=14
RAG_CONTEXT_CHUNKS=6
RAG_MAX_CHUNKS_PER_PAGE=2
RAG_RERANK_CANDIDATES=24
SITE_CATALOG_MAX_ITEMS=80

SEMANTIC_TOP_K=10
SEMANTIC_MIN_SCORE=0.2
GLOSSARY_EXPANSION_ENABLED=true
GLOSSARY_MAX_TERMS=12

# =========================================================
# MODEL PROVIDER & EMBEDDING
# =========================================================
LLM_PROVIDER=groq
OPENAI_AUTH_MODE=api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.1
OPENAI_FALLBACK_MODELS=gpt-5.1,gpt-5-mini,gpt-5-nano

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.1-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct
GROQ_RETRY_MAX_ATTEMPTS=3
GROQ_RETRY_BASE_DELAY_MS=350

EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256
OPENAI_API_KEY=

# =========================================================
# CHAT WINDOW, TOKEN BUDGET, RESPONSE GUARD
# =========================================================
OPENAI_HISTORY_LIMIT=4
OPENAI_MESSAGE_MAX_CHARS=1800

LLM_MAX_INPUT_TOKENS=2600
LLM_MAX_HISTORY_MESSAGES=4
LLM_MAX_HISTORY_CHARS=600
LLM_MAX_CONTEXT_PAGES=6
LLM_MAX_CONTEXT_CONTENT_CHARS=900
LLM_MAX_CONTEXT_SUMMARY_CHARS=260
LLM_MAX_SITE_CATALOG=30
LLM_MAX_TOOL_MANIFESTS=2
LLM_MAX_TOOL_FIELDS=8
LLM_MAX_TOOL_STEPS=6
LOW_CONFIDENCE_THRESHOLD=0.42
CS_ONLY_MODE=true
STRICT_GROUNDING_ENABLED=true
STRICT_GROUNDING_MIN_CONFIDENCE=0.46
STRICT_GROUNDING_REQUIRE_SOURCE=true
STRICT_WEBSITE_SCOPE_ENABLED=true

# =========================================================
# INTENT EXPERIMENT (A/B)
# =========================================================
AB_EXPERIMENT_ENABLED=false
AB_VARIANTS=control,concise,advisor
AB_MODEL_CONTROL=llama-3.1-8b-instant
AB_MODEL_CONCISE=llama-3.1-8b-instant
AB_MODEL_ADVISOR=llama-3.1-70b-versatile

# =========================================================
# MEMORY & LEARNING LOOP
# =========================================================
MEMORY_STORE_PATH=/var/lib/ai_fastapi/memory_store.json
MEMORY_MAX_TURNS=8
MEMORY_TTL_SECONDS=604800

LEARNING_STORE_PATH=/var/lib/ai_fastapi/learning_store.json
LEARNING_MAX_EVENTS=4000

RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_PATH=/var/lib/ai_fastapi/response_cache.json
RESPONSE_CACHE_TTL_SECONDS=900
RESPONSE_CACHE_MAX_ITEMS=1500

# =========================================================
# CHANNEL POLICY
# =========================================================
CHANNEL_POLICY_WEB_MAX_SENTENCES=5
CHANNEL_POLICY_OPENCLAW_MAX_SENTENCES=3
CHANNEL_POLICY_OPENAI_MAX_SENTENCES=4

# =========================================================
# OPENCLAW (OFFICIAL MODE: NATIVE CODEX)
# =========================================================
# Required when running profile "openclaw" via preflight wrapper scripts.
OPENCLAW_WEBHOOK_KEY=change-this-openclaw-key
# Optional compatibility key if you still route OpenClaw via /v1/chat/completions.
OPENCLAW_COMPAT_API_KEY=change-this-openclaw-compat-key
# Compatibility model id used by FastAPI OpenAI-compatible bridge.
OPENCLAW_COMPAT_MODEL_ID=xiao-an
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_PREFIX_GATE_ENABLED=false
OPENCLAW_REQUIRED_PREFIX=/ia
OPENCLAW_PREFIX_GATE_HARD_IGNORE=true
OPENCLAW_PREFIX_REMINDER_COOLDOWN_SECONDS=25200
OPENCLAW_PREFIX_REMINDER_TEXT=Maaf, Ar gege masih sibuk. Coba kabari lagi nanti atau ngobrol sama aku dulu pakai prefix {prefix} ya.
OPENCLAW_PREFIX_REMINDER_TEXT_EN=Sorry, Ar gege is still busy right now. Please try again later, or chat with me first using prefix {prefix}.
OPENCLAW_PREFIX_GATE_STORE_PATH=/var/lib/ai_fastapi/openclaw_prefix_gate.json
OPENCLAW_NATIVE_DM_GATE_ENABLED=true
# Leave empty to auto-derive from SEARCH_API_URL/SITE_BASE_URL.
OPENCLAW_OWNER_NOTIFY_URL=http://laravel_franken:8000/api/internal/ai/openclaw/owner-notify
# Leave empty to fallback to AI_INTERNAL_SEARCH_KEY / SEARCH_API_KEY.
OPENCLAW_OWNER_NOTIFY_KEY=
OPENCLAW_OWNER_NOTIFY_AUTH_HEADER=X-Search-Key
OPENCLAW_OWNER_NOTIFY_TIMEOUT_MS=4500

# =========================================================
# HUMAN HANDOFF
# =========================================================
HUMAN_HANDOFF_ENABLED=true
HUMAN_HANDOFF_LOW_CONF_STREAK=2
HUMAN_HANDOFF_STATE_PATH=/var/lib/ai_fastapi/handoff_state.json
HUMAN_HANDOFF_CONTACT_URL=/contact
HUMAN_HANDOFF_KEYWORDS=admin,operator,cs,customer service,human,real person,staff,agent,orang asli,orang beneran,hubungi tim,telepon,call me

# =========================================================
# AUTO INDEX EVENTS (FOR LARAVEL HOOK)
# =========================================================
AUTO_INDEX_ENABLED=true
AUTO_INDEX_DEBOUNCE_SECONDS=10
AUTO_INDEX_MAX_BATCH=120

# =========================================================
# SLO ALERTING
# =========================================================
SLO_ALERT_ENABLED=false
SLO_ALERT_WEBHOOK_URL=
SLO_ALERT_COOLDOWN_SECONDS=300
SLO_HTTP_5XX_RATE_THRESHOLD=0.05
SLO_CHAT_LATENCY_MS_THRESHOLD=5000
SLO_CHAT_CONFIDENCE_THRESHOLD=0.45
SLO_MIN_SAMPLE_SIZE=20

# =========================================================
# PROMPT BRIEF
# =========================================================
SITE_NAVIGATION_BRIEF=Fokus website Aryakun: pricing, fitur, profil/tentang Aryakun, dan kontak. Selalu berikan link halaman paling relevan jika tersedia.
