# Mock values only. Tambahkan ke .env website Laravel dan ganti sesuai environment asli.
AI_API_BASE_URL=http://ai_fastapi:8008
AI_API_TIMEOUT=90
AI_AUTO_INDEX_ENABLED=true
AI_AUTO_INDEX_TIMEOUT=8
AI_INTERNAL_SEARCH_KEY=change-this-long-random-key
